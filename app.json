{
  "expo": {
    "name": "Lingua",
    "slug": "language-learning",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lingua",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.durolipons.lingua",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We use the microphone to give you pronunciation feedback.",
        "NSSpeechRecognitionUsageDescription": "We use speech recognition to check your pronunciation."
      }
    },
    "android": {
      "package": "com.durolipons.lingua",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4f46e5"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "outputManifest": true,
      "config": {
        "pwa": {
          "start_url": "/",
          "display": "standalone",
          "background_color": "#4f46e5",
          "theme_color": "#4f46e5",
          "orientation": "portrait",
          "scope": "/"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Lingua to use the microphone for pronunciation practice.",
          "speechRecognitionPermission": "Allow Lingua to use speech recognition for pronunciation feedback."
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-audio",
      "expo-asset"
    ]
  }
}
